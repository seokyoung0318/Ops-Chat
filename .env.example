# 설정 견본 — 이 파일을 .env 로 복사해서 본인 값으로 채운다 (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어 git 에 올라가지 않는다. 실제 키를 이 파일에 적지 말 것.

# LangSmith 추적 설정. 사용하지 않으려면 LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=여기에_본인_LangSmith_키
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 모드(run_agent_openai.sh)에서만 필요하다. 과금되는 키다.
# 로컬 Ollama(run_agent_ollma.sh)만 쓰면 비워 둬도 된다.
OPENAI_API_KEY=여기에_본인_OpenAI_키
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# 선택 설정 (기본값 그대로면 적지 않아도 됨)
# CLASSIFIER=rag          # rag(의미 검색) | rules(기존 키워드 규칙, Before 비교용)
# RAG_INPUT=auto          # auto | query | query+alerts
# RAG_THRESHOLD=0.5       # 이 점수 미만이면 "맞는 매뉴얼 없음"
# EMBED_MODEL=bge-m3
